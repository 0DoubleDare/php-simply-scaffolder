import { Button, LineEdit, VerticalBox, ProgressIndicator, Button, HorizontalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    width: 700px;
    height: 450px;
    title: "PHP Generator";

    in-out property <bool> is-loading: false;
    in-out property <bool> url-edit-is-enabled: false;

    in-out property <string> target-install-path: "";
    in-out property <string> template-archive-url: "https://github.com/0DoubleDare/php-generator";

    callback pick-target-folder();
    callback start-install-template();
    callback toggle-url-line-edit(bool);

    VerticalBox {
        alignment: center;
        cross-axis-alignment: center;
        spacing: 10px;
        Button {
            text: "Выберите папку";
            width: 300px;
            height: 40px;
            primary: true;
            enabled: !root.is-loading;
        }

        LineEdit {
            placeholder-text: "Директория установки";
            text: root.target-install-path;
            width: 400px;
            height: 30px;
            enabled: !root.is-loading;
            edited(text) => {
                root.target-install-path = self.text;
            }
        }
        Button {
            text: "Создать проект";
            enabled: root.target-install-path == "" ? false : true;
            clicked => {
                root.start-install-template();
            }
        }
        HorizontalBox {
            LineEdit {
                opacity: root.url-edit-is-enabled ? 1.0 : 0.5;
                placeholder-text: "URL шаблона";
                text: root.template-archive-url;
                width: 500px;
                height: 30px;
                enabled: root.url-edit-is-enabled;
            }
            Button {
                opacity: 0.7;
                icon: root.url-edit-is-enabled ? @image-url("../assets/lock-open.svg") : @image-url("../assets/lock-closed.svg");
                colorize-icon: true;
                clicked => {
                    root.toggle-url-line-edit(root.url-edit-is-enabled)
                }
            }
        }
        ProgressIndicator {
            indeterminate: true;
        }
    }
}
